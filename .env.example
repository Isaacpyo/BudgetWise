# BudgetWise environment variables. Copy to .env for docker compose / local runs.
# Never commit real values. Everything has a working local default.

# ─── API (apps/api) — set these on Render ─────────────────────────────────────
# development | test | production
NODE_ENV=development
# Port to listen on (Render injects PORT automatically)
PORT=8787
# Comma-separated browser origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
# Pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# "mock" = built-in sandbox bank (no keys needed); "plaid" = Plaid sandbox
PLAID_PROVIDER=mock
# Plaid sandbox credentials (dashboard.plaid.com → Developers → Keys). Server only!
PLAID_CLIENT_ID=
PLAID_SECRET=
# Deep-link prefixes Plaid Hosted Link may redirect to after linking (native app)
HOSTED_LINK_REDIRECT_PREFIXES=budgetwise://,exp://,exps://

# Firebase project id (use demo-budgetwise with the emulators)
FIREBASE_PROJECT_ID=demo-budgetwise
# Service-account JSON for the Admin SDK, raw or base64. Required in production.
FIREBASE_SERVICE_ACCOUNT=
# Point the Admin SDK at local emulators (leave empty in production)
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# 32-byte key (base64 or hex) encrypting Plaid access tokens at rest.
# Generate with: openssl rand -base64 32   (required in production)
TOKEN_ENCRYPTION_KEY=

# Shared demo account used by "Try the demo"
DEMO_UID=demo-user
# Re-seed the demo account when its data is older than this many hours
DEMO_RESEED_HOURS=6
# Seed the demo account when the API boots
SEED_DEMO_ON_START=true

# ─── Web app (apps/web) — set these on Netlify (inlined at build time) ────────
# Public URL of the API (Render): https://budgetwise-api.onrender.com
EXPO_PUBLIC_API_URL=http://localhost:8787
# Firebase web app config (Project settings → Your apps → Web app). Public by design.
EXPO_PUBLIC_FIREBASE_API_KEY=demo-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-budgetwise
EXPO_PUBLIC_FIREBASE_APP_ID=
# Use the local Auth/Firestore emulators (never set in production)
EXPO_PUBLIC_USE_FIREBASE_EMULATORS=true
# Host the browser/device uses to reach the emulators
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=localhost

# ─── Tests ────────────────────────────────────────────────────────────────────
# Optional: use a preinstalled Chromium instead of `npx playwright install`
PLAYWRIGHT_CHROMIUM_EXECUTABLE=
